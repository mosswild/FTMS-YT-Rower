# FTMS-Rower Container Configuration
# Copy this file to `.env` to customize container parameters

# Web Server Port (Host and Container)
PORT=8000

# User & Group Mapping (Matches host permissions for mounted ./config)
PUID=1000
PGID=1000
TZ=Etc/UTC

# Persistent Directories (Inside container)
DATA_DIR=/config/data
MEDIA_DIR=/config/media

# Optional HTTPS / SSL (Required for Bluefy browser or remote Web Bluetooth)
# Set AUTO_HTTPS=true to automatically generate a self-signed SSL certificate in ./config/ssl
# AUTO_HTTPS=true
# Or specify your own certificate paths:
# SSL_CERTFILE=/config/ssl/fullchain.pem
# SSL_KEYFILE=/config/ssl/privkey.pem

# Optional: Embedded Host Bluetooth Relay (Runs inside container on Linux with host D-Bus)
# ENABLE_BLUETOOTH_RELAY=true
# BLE_DEVICE_NAME=Concept2
# BLE_DEVICE_ADDRESS=XX:XX:XX:XX:XX:XX
